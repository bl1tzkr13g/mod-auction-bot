# For SellPrice=0 without a fixed price: SKIP (default), or HISTORICAL fallback.
AuctionSim.Pricing.Buy.ZeroVendorPolicy = SKIP
AuctionSim.Pricing.Sell.ZeroVendorPolicy = SKIP

# Percent jitter around custom sell prices. 0 keeps the initial price list exact.
# Range 0..100. The floor applies to custom buyouts after variation and to starting bids.
AuctionSim.Pricing.Sell.VariationPercent = 0
AuctionSim.Pricing.Sell.MinimumVendorMultiplier = 1.0

# Quantity per item ID and gold reserved per UTC day; 0 = unlimited.
# Shared across both houses, regardless of price mode. Applied at execution so
# queued actions cannot exceed the budget together. Bids reserve the full amount;
# later bids on the same auction charge only the increase and count quantity once.
# Outbid/expired reservations are not refunded. Retained across pricing reloads,
# but reset on worldserver restart. These are conservative session safeguards.
AuctionSim.Pricing.Buy.DailyItemLimit = 0
AuctionSim.Pricing.Buy.DailyGoldBudget = 0

# 0 bypasses custom PRICE caps for bids; daily limits and original guards remain.
AuctionSim.Pricing.Buy.ApplyToBids = 1

# GM/console: auctionsim pricing reload | auctionsim pricing show <ItemID>
# Reload drops pending purchases; existing auctions keep their posted prices.
# Changing pricing sources does not change auction supply or item eligibility.
